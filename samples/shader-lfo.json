      "shader": "precision mediump float;\nuniform vec2 u_res;\nuniform float u_time;\nuniform float x1, x2, x3, x4;\nuniform sampler2D u_cam;\nuniform float u_hasCam;\nvoid main() {\n  vec2 uv = gl_FragCoord.xy / u_res;\n  vec2 p = uv * 2.0 - 1.0;\n  p.x *= u_res.x / u_res.y;\n  p *= 1.0 + x4 * 1.5;\n  float a = atan(p.y, p.x) + x3 * 3.14159;\n  float r = length(p);\n  float v = sin(r * (8.0 + x1 * 12.0) - u_time * 2.0) + sin(a * (4.0 + x2 * 6.0) + u_time);\n  vec3 synth = vec3(0.5 + 0.5 * sin(v + x3), 0.5 + 0.5 * sin(v + 2.0), 0.5 + 0.5 * sin(v + 4.0));\n  vec3 cam = texture2D(u_cam, uv).rgb;\n  gl_FragColor = vec4(mix(synth, cam, u_hasCam * 0.5), 1.0);\n}",
